{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "address": { "type": "string", "maxLength": 253 },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "site": { "type": "string", "maxLength": 64 },
    "fingerprint": { "type": "string", "maxLength": 128 },
    "allowChanges": { "type": "boolean" }
  },
  "required": ["address", "port", "site", "fingerprint", "allowChanges"],
  "additionalProperties": false
}
